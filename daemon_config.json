{
  "daemon_name": "MockClaw Immortal Daemon",
  "version": "3.0.0",
  "author": "Yang Quanheng (via Qclaw Daemon)",
  "created_at": "2026-03-29T01:08:00Z",
  "status": "ACTIVE",
  
  "tasks": [
    {
      "id": "753996f9-05fc-49c7-9917-bb56e51f1d4f",
      "name": "immortal_main",
      "type": "recurring",
      "interval": "1 hour",
      "description": "Main evolution loop - runs janitor, generate, chaos, polish, validate",
      "timeout_seconds": 600,
      "work_directory": "D:\\mockclaw-immortal",
      "on_complete": "reschedule_self",
      "on_failure": "trigger_immortal_repair"
    },
    {
      "id": "01dfda6a-4a62-4190-b886-d63598601c00",
      "name": "immortal_watchdog",
      "type": "recurring",
      "interval": "30 minutes",
      "description": "Monitors main task for heartbeat",
      "timeout_seconds": 120,
      "trigger_condition": "no_heartbeat_15min"
    },
    {
      "id": "b71f85fe-4271-4bc1-a174-e590be2e03c1",
      "name": "immortal_repair",
      "type": "recurring",
      "interval": "2 hours",
      "description": "Analyzes failures, generates patches, triggers restart",
      "timeout_seconds": 300,
      "trigger_condition": "on_failure_of_immortal_main"
    }
  ],
  
  "execution_flow": {
    "normal_cycle": [
      "immortal_main runs every hour",
      "immortal_watchdog checks every 30 minutes",
      "If all OK, repeat"
    ],
    "failure_cycle": [
      "immortal_main fails",
      "immortal_watchdog detects no heartbeat",
      "immortal_repair triggered",
      "Patches generated and applied",
      "immortal_main restarted"
    ]
  },
  
  "logs": {
    "heartbeat": "D:\\mockclaw-immortal\\logs\\heartbeat.log",
    "evolution": "D:\\mockclaw-immortal\\logs\\evolution_history.md",
    "crash": "D:\\mockclaw-immortal\\logs\\crash_history.log",
    "repair": "D:\\mockclaw-immortal\\logs\\repair_history.log"
  },
  
  "critical_test_case": {
    "endpoint": "POST /checkout",
    "payload": {"coupon_code": "EXPIRED2026"},
    "expected_status": 400,
    "description": "The gauntlet validates this error handling"
  },
  
  "self_healing": {
    "retry_logic": "Exponential backoff, max 3 retries",
    "watchdog_timeout": "600 seconds",
    "auto_respawn": true,
    "patch_persistence": "logs/patches.json"
  },
  
  "chaos_engineering": {
    "concurrency_test": "50 parallel requests",
    "garbage_data": ["nulls", "5000-char strings", "XSS", "SQL injection"],
    "docker_kill": true,
    "network_drop": true,
    "disk_full": true
  }
}
