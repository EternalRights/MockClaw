# MockClaw Configuration
# Copy this file to .env and fill in your values

# LLM Integration (optional - works without these)
LLM_API_KEY=
# Custom endpoint for OpenAI-compatible APIs (e.g. Azure, local LLM)
LLM_BASE_URL=
# Model identifier (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Optional: OpenAI-compatible API key (alternative to LLM_API_KEY)
OPENAI_API_KEY=
